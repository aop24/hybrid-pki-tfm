[Unit]
Description=PHC certificate distribution service (WireGuard only)
Requires=wg-quick@wg0.service
After=wg-quick@wg0.service network-online.target

[Service]
Type=simple
User=ca
Group=ca
WorkingDirectory=/home/ca/phc-certdist
ExecStart=/home/ca/phc-certdist/bin/certdist-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
