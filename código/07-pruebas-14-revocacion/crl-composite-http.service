[Unit]
Description=HTTP publication of the Composite sub CA CRL (port 8081, read-only directory)
After=network-online.target

[Service]
Type=simple
User=ca
Group=ca
ExecStart=/usr/bin/python3 -m http.server 8081 --bind 0.0.0.0 --directory /home/ca/pki/composite/pub
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
