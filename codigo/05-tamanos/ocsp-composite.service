[Unit]
Description=OCSP responder of the Composite hierarchy (openssl ocsp, port 2560, all interfaces like the EJBCA OCSP on 8080)
After=wg-quick@wg0.service network-online.target
Wants=wg-quick@wg0.service

[Service]
Type=simple
User=ca
Group=ca
Environment=LD_LIBRARY_PATH=/opt/openssl32/lib64:/opt/openssl32/lib
# -nmin 5: nextUpdate = thisUpdate + 5 min (same TTL as the EJBCA responders, 300 s).
# The index is reloaded automatically when index.txt changes (hot revocation, block 14).
ExecStart=/opt/openssl32/bin/openssl ocsp -port 2560 \
  -index /home/ca/pki/composite/sub/index.txt \
  -CA /home/ca/pki/composite/sub/tfm-sub-ca-composite.crt \
  -rsigner /home/ca/pki/composite/ocsp/tfm-ocsp-composite.crt \
  -rkey /home/ca/pki/composite/ocsp/tfm-ocsp-composite.key \
  -nmin 5 -ignore_err
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
